datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  name         String
  mobile       String    @unique
  role         String    // CONTRACTOR, LABORER, SUPPLIER, DELIVERY_AGENT, ADMIN
  maskedGovtId String?
  isVerified   Boolean   @default(true)
  status       String    @default("APPROVED")
  rating       Float     @default(4.8)
  createdAt    DateTime  @default(now())
}

model Material {
  id           String    @id @default(uuid())
  name         String
  category     String    // Cement, Steel, Bricks, Sand
  unit         String
  basePrice    Float
  marketAvg    Float
  stock        Int
  rating       Float     @default(4.8)
  supplierName String
  createdAt    DateTime  @default(now())
}

model LaborSquad {
  id                 String    @id @default(uuid())
  trade              String
  leadName           String
  squadSize          Int
  dailyRatePerWorker Float
  sardarCut          Float     @default(50.0)
  platformFee        Float     @default(0.0)
  verifiedSkillScore Float     @default(0.92)
  rating             Float     @default(4.8)
  location           String
  createdAt          DateTime  @default(now())
}

model KhataRecord {
  id             String    @id @default(uuid())
  date           String
  category       String    // LABOR, MATERIAL, PETTY_CASH
  title          String
  entity         String
  promisedAmount Float
  paidAmount     Float
  status         String    @default("SETTLED")
  note           String?
  createdAt      DateTime  @default(now())
}

model DeliveryTracking {
  id                  String    @id @default(uuid())
  orderNumber         String    @unique
  material            String
  quantity            String
  driverName          String
  truckNumber         String
  otpCode             String
  status              String    @default("IN_TRANSIT")
  batchAgeMinutes     Int       @default(40)
  maxShelfLifeMinutes Int       @default(90)
  createdAt           DateTime  @default(now())
}
